# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Secret used to sign session cookies (required in production, 32+ characters)
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Optional bootstrap admin login (leave empty to only allow admins stored in the database)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: password given to all demo accounts by db/seed.ts (defaults to password123)
SEED_PASSWORD=
